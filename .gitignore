# Vendored corelibs + tooling (populated by scripts/bootstrap.sh)
/vendor/
/tools/sofabgen

# Per-driver build + generated code
/drivers/*/build/
/drivers/*/gen/
/drivers/*/fuzz-gen/
/drivers/go/message/
/drivers/go/go.sum

# Fuzzing artifacts
/corpus/interesting/*
/corpus/crashes/*
/corpus/stream/*
!/corpus/interesting/.gitkeep
!/corpus/crashes/.gitkeep
!/corpus/stream/.gitkeep
# the union engine's own corpus (scripts/fuzz.sh FUZZ_CORPUS): bytes shaped for probe-union-deep
/corpus/interesting-union/*
!/corpus/interesting-union/.gitkeep
/corpus/stream-union/*
!/corpus/stream-union/.gitkeep
# libFuzzer per-job logs (fuzz.sh with -jobs writes these to the repo root)
/fuzz-*.log
# Coredumps from a crashing driver/pacemaker
/core
core.*

# Go native-fuzz corpus cache
testdata/fuzz/

.env

# Python bytecode cache
__pycache__/

# Go fuzz seed corpus — regenerated from corpus/ on every scripts/fuzz-go.sh run
/drivers/go/testdata/
